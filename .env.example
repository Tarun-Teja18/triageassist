# Copy this file to .env and fill in your real values:
#     cp .env.example .env
#
# .env is gitignored and must NEVER be committed.
# This file (.env.example) IS committed — it documents which variables exist
# without leaking any values. Anyone cloning the repo reads this to know what
# to set up.

# Your Groq API key. Get one free (no credit card) at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Which Groq-hosted model to use. Groq retires models periodically, so treat
# this as something you may need to update. Check the current list at
# https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
